data/studysphere.db*

# Python bytecode & virtual environments
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd

# Test caches & temporary artifacts
.pytest_cache/
.coverage
htmlcov/
*.log
