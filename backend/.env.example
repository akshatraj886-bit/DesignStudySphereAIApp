# Server Host and Port Configuration
HOST=127.0.0.1
PORT=8000

# Environment Mode: 'development' or 'production'
# In production: strict session auth is enforced by default, preventing unauthenticated shared sessions
ENVIRONMENT=development

# Multi-Tenant Session Security:
# Set to 'true' in public production to reject requests missing X-Session-Token with HTTP 401
STRICT_SESSION_AUTH=false

# Rate Limiting & Abuse Protection:
# Set to 'true' to enforce in-memory sliding window rate limits (10 uploads/min, 30 asks/min, 20 gens/min)
RATE_LIMIT_ENABLED=true

# Resource Limits:
# Maximum allowed PDF upload size in megabytes (default: 25 to protect low-memory free-tier containers)
MAX_UPLOAD_SIZE_MB=25

# Comma-separated list of allowed frontend origins for CORS
# 8443 is the default port used in vite.config.ts; 5173 is standard Vite default
ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173,https://design-study-sphere-ai-app.vercel.app

# Database Configuration: Local SQLite vs Cloud PostgreSQL
# Default (empty): zero-setup local SQLite at backend/data/studysphere.db
# DATABASE_PATH=/var/data/studysphere.db
#
# Cloud PostgreSQL (e.g., Neon Free Tier, ₹0 budget):
# Set DATABASE_URL to your PostgreSQL connection string with SSL required:
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google Gemini API Configuration (Free Tier via Google AI Studio)
# Obtain a free key from: https://aistudio.google.com/
# Leave empty to use the offline Grounded Extractive Synthesizer
# IMPORTANT: Never commit or expose actual API keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=12.0

# Optional Local Ollama Configuration (disabled by default)
# Enable Ollama for local LLM generation (requires Ollama running with the configured model)
# For local development: start Ollama on your machine, pull the model, and set OLLAMA_ENABLED=true
# For production: OLLAMA_HOST must point to a reachable Ollama instance (not localhost)
#   The Render-deployed backend CANNOT reach Ollama on your laptop.
#   You would need a cloud-hosted Ollama service or a tunnel (e.g., ngrok) with authentication.
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
# Generation model for Ollama (default: qwen2.5:1.5b per DDRAG reference)
# Pull it first: ollama pull qwen2.5:1.5b
OLLAMA_MODEL=qwen2.5:1.5b
# Generation timeout in seconds (default: 30s, increase for slower hardware)
OLLAMA_TIMEOUT_SECONDS=30.0
