# StudySphere AI Frontend Environment Configuration
#
# Local Development (default):
# VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Production Deployment on Vercel:
# Set VITE_API_BASE_URL in your Vercel Project Settings -> Environment Variables
# pointing to your deployed FastAPI backend URL (e.g. Hugging Face Space):
# VITE_API_BASE_URL=https://<your-username>-studysphere-backend.hf.space
#
# CRITICAL SECURITY RULES:
# 1. Never put server secrets (GEMINI_API_KEY, DATABASE_URL) in VITE_* variables.
# 2. Vite bakes VITE_* variables directly into public client JavaScript bundles!
VITE_API_BASE_URL=http://127.0.0.1:8000
